# MySQL connection (async driver: asyncmy)
# Example: mysql+asyncmy://app_user:app_password@localhost:3306/workmate
DATABASE_URL=mysql+asyncmy://root:experion%40123@localhost:3306/workmate

# JWT settings
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated origins allowed to call this API (the frontend dev server by default)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
